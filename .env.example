# =============================================================================
# Sofia — environment configuration. Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Telegram ----------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Leave EMPTY on first run: the bot then starts in
# setup mode and replies to you with your id. Put it here and restart.
ALLOWED_TELEGRAM_USER_ID=
# Optional short reply for strangers. Empty = ignore them silently (recommended).
UNAUTHORIZED_REPLY=

# --- LLM -------------------------------------------------------------------------
# openai             = OpenAI Responses API (default)
# openai_compatible  = any OpenAI-compatible Chat Completions endpoint (set LLM_BASE_URL)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Chat model. Must support image input (for photos) and Structured Outputs.
# Pick a current model from OpenAI's model list; e.g. a GPT-6 "Sol" tier for quality,
# a "Luna" tier for lower cost/latency. Example:
LLM_MODEL=gpt-6.1-sol
# Reasoning effort for reasoning models: none|minimal|low|medium|high. Low keeps texting fast.
# Leave empty for models that don't accept the parameter.
LLM_REASONING_EFFORT=low
# Optional: low|medium|high (GPT-5+ models). Empty = model default.
LLM_VERBOSITY=
# Optional sampling temperature. Many reasoning models reject it — leave empty unless you know.
LLM_TEMPERATURE=
# Output budget per call; reasoning tokens count towards it.
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TIMEOUT_SECONDS=90
# Only for LLM_PROVIDER=openai_compatible (or an OpenAI-compatible proxy):
LLM_BASE_URL=
# json_schema (preferred) | json_object (for endpoints without strict JSON schema support)
LLM_JSON_MODE=json_schema
# Cheaper model for background work (episode summaries, memory consolidation). Empty = LLM_MODEL.
UTILITY_MODEL=gpt-6-luna
# Embeddings for semantic memory retrieval. Empty = lexical retrieval only.
EMBEDDING_MODEL=text-embedding-3-small
# Speech-to-text for voice messages. Empty = voice messages are not transcribed.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Send photos to the model so Sofia can react to them.
VISION_ENABLED=true
# low|high|auto|original — low is cheapest.
IMAGE_DETAIL=auto

# --- Behaviour -------------------------------------------------------------------
TIMEZONE=Europe/Amsterdam
# Spontaneous messages. Toggle at runtime with /proactive on|off.
PROACTIVE_DEFAULT=false
PROACTIVE_MAX_PER_DAY=2
QUIET_HOURS_START=23:30
QUIET_HOURS_END=08:30
# Wait this long for follow-up messages before replying (people send thoughts in pieces).
DEBOUNCE_SECONDS=2.2
DEBOUNCE_MAX_SECONDS=9
# Verbatim chat context per call.
RECENT_MESSAGES_MAX=40
RECENT_TOKENS_BUDGET=3500
# Regenerate once if a reply slips into assistant voice ("How can I help?").
STYLE_GUARD_REGENERATE=true

# --- Storage -----------------------------------------------------------------------
DATABASE_PATH=./data/sofia.db
PERSONA_DIR=./persona
# Keep photos Bram sends on disk (default: processed in memory only).
KEEP_IMAGES=false

# --- Telegram transport -----------------------------------------------------------
# polling (default, simplest) | webhook (needs a public HTTPS URL + pip install "python-telegram-bot[webhooks]")
TELEGRAM_MODE=polling
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_SECRET=

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
